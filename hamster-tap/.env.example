# Скопируйте в .env и заполните.
# Без BOT_TOKEN сервер работает в локальном (dev) режиме: можно открыть игру
# в обычном браузере и играть за тестового пользователя.

# Токен бота от @BotFather. Пусто -> dev-режим.
BOT_TOKEN=

# Юзернейм бота без @ — нужен для ссылок-рефералок в боте.
BOT_USERNAME=

# Ваш chat_id: используется tools/push-test.js, чтобы проверить доставку напоминаний.
# Узнать можно у @userinfobot.
ADMIN_CHAT_ID=

# Публичный HTTPS-адрес мини-аппа (без слэша в конце).
# Нужен, чтобы бот показывал кнопку "Открыть игру" (Telegram требует HTTPS).
# Локально: cloudflared tunnel --url http://localhost:8020  ->  https://xxx.trycloudflare.com
WEBAPP_URL=

# Сервер, порт (по умолчанию 8020)
PORT=8020

# Папка/файл базы SQLite
DB_PATH=./data/app.db

# Разрешить вход без Telegram даже когда BOT_TOKEN задан (удобно для отладки).
# ALLOW_DEV=1

# Реклама за энергию. Порядок сетей: первая доступная показывает рекламу,
# следующая подхватывает, если у первой нет кампании или она не сработала.
#   monetag — rewarded видео внутри мини-аппа (нужны зона и адрес SDK)
#   chanify — реклама приходит сообщением от бота в чат (запасной вариант)
AD_PROVIDERS=monetag,chanify

# Monetag: главная зона SDK (одна на мини-апп) и адрес SDK-скрипта из тега в кабинете.
# Оба значения публичные (в клиент уходят как есть), сеть включается только когда
# заполнены обе строки — иначе запрос уходит следующей сети.
MONETAG_ZONE=
MONETAG_SDK_URL=

# Пассивная реклама Monetag (In-App Interstitial): «частота/окно_в_часах/интервал_с/
# задержка_с/сброс_при_перезагрузке», например 2/0.1/30/5/0 — до 2 показов за 6 минут,
# пауза 30 секунд, первый показ через 5 секунд. Пусто — формат выключен.
# Энергии не даёт: показывается сам, платят за CPM.
MONETAG_INAPP_SETTINGS=

# Постбеки Monetag (подтверждение показа сетью). Секрет — часть адреса эндпоинта,
# который вставляется в кабинете в настройках главной зоны:
#   https://<адрес>/api/ads/monetag/<секрет>?ymid={ymid}&event={event_type}
#     &value={reward_event_type}&zone={zone_id}&sub={sub_zone_id}&source={request_var}
# Пусто — приём постбеков выключен (эндпоинт отвечает 404).
MONETAG_POSTBACK_SECRET=

# 1 — награду выдаём только после постбека сети (надёжнее, но требует, чтобы постбек
# был настроен в кабинете). По умолчанию 0: кредит по колбэку клиента, постбек пишем
# в базу для сверки.
# MONETAG_REQUIRE_POSTBACK=1

# Страховка на случай, если в кабинете ещё не сохранили Postback URL: сколько
# миллисекунд ждать постбек после того, как клиент сообщил о досмотренном ролике,
# прежде чем выдать награду без подтверждения сети. Такие выдачи видно по
# postback_at = 0. 0 — не выдавать без подтверждения вовсе (жёсткая проверка).
MONETAG_POSTBACK_GRACE_MS=20000

# Chanify. Ключ издателя из кабинета: Publisher → My Bots → Add Bot.
# Секрет: в клиент не попадает, только на сервер.
CHANIFY_API_KEY=

# Режим рекламы: live — настоящие показы, stub — тестовый (сеть не дёргается,
# показ считается успешным, только для сетей с рекламой в чате).
# Автотесты выставляют stub сами.
AD_MODE=live

# Реклама после ответов бота (/start, /me, /top, /code): 1 — показывать.
# По умолчанию выключено: реклама живёт только в кнопке «энергия за рекламу».
# AD_BOT_ADS=1

# --- Оплата ---
# Внутри Telegram товары продаются за звёзды (требование правил платформы), рублёвые
# платежи идут на внешнюю страницу (свой домен) через ЮKassa. Пока канал не включён,
# PAYMENTS_PROVIDER=stars и мини-апп работает как прежде.
PAYMENTS_PROVIDER=stars

# Внешняя страница оплаты: origin нужен для CORS (другой домен), url — для ссылки в боте.
PAY_PAGE_ORIGIN=
PAY_PAGE_URL=

# Подпись личных ссылок на оплату (?t=...): пусто — берём BOT_TOKEN.
PAY_LINK_SECRET=
# Срок жизни ссылки в миллисекундах (по умолчанию 30 минут).
PAY_LINK_TTL_MS=1800000

# ЮKassa: shopId публичный, секретный ключ — только на сервере; уведомления проверяются
# по официальному списку IP ЮKassa и повторным запросом статуса платежа.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_RETURN_URL=
# 1 — передавать чек в запросе платежа (если в кабинете включены «Чеки от ЮKassa»).
# YOOKASSA_RECEIPTS=1

# Запускать long polling бота вместе с сервером (то же, что флаг --bot).
# RUN_BOT=1
